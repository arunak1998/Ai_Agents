# Copy this file to .env and replace the key below.
#   cp .env.example .env

# REQUIRED: your API key. This is the only key the app needs.
LLM_API_KEY=your_api_key_here

# OPTIONAL: set only if you use a gateway or proxy instead of OpenAI.
# LLM_BASE_URL=https://your-gateway.example.com

# OPTIONAL: model name (default: gpt-5-mini).
# LLM_MODEL=gpt-5-mini

# OPTIONAL: faster answers on gpt-5 models. Delete this line for other models.
LLM_REASONING_EFFORT=minimal
